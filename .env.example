# 백엔드 주소 (vite dev 프록시 /api 대상)
VITE_API_TARGET=http://localhost:8080
# 개발용 자동 로그인: true면 목업 계정(buyer)으로 로그인된 상태로 시작. 미리보기·운영에서는 설정하지 않음
VITE_MOCK_AUTH=false
# 백엔드 연동 전 미리보기용 데모 로그인: true면 로그인 화면에 구매자·판매자·운영자 계정 버튼 표시 (비밀번호 Stockdrop123!)
# 백엔드 API 연동 후에는 false 또는 삭제 → 실제 로그인만 가능
VITE_DEMO_LOGIN=false

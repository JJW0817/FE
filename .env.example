# mock 모드: true면 서버를 호출하지 않고 목업 데이터로만 동작(역할 선택 데모 로그인 표시). 기본(미설정)은 실제 API.
# Vercel 미리보기는 서버 연결 전까지 true로 둔다. 아래 VITE_DEMO_LOGIN·VITE_MOCK_AUTH가 true여도 mock 모드로 본다. 단 VITE_USE_MOCK=false를 명시하면 그 둘이 true여도 실제 API 모드.
VITE_USE_MOCK=false
# 백엔드 주소 (vite dev 프록시). /api → Gateway, /pg → PurchaseGateway. 터널 주소(https://…)도 가능
VITE_API_TARGET=http://localhost:8000
VITE_PG_TARGET=http://localhost:8001
# 개발용 자동 로그인: true면 목업 계정(buyer)으로 로그인된 상태로 시작. 미리보기·운영에서는 설정하지 않음
VITE_MOCK_AUTH=false
# 백엔드 연동 전 미리보기용 데모 로그인: true면 로그인 화면에 구매자·판매자·운영자 계정 버튼 표시 (비밀번호 Stockdrop123!)
# 백엔드 API 연동 후에는 false 또는 삭제 → 실제 로그인만 가능
VITE_DEMO_LOGIN=false

# 현재 위치로 주소 찾기(카카오 지도 JavaScript 키). 발급·도메인 등록은 docs/kakao.md
VITE_KAKAO_JS_KEY=
